-- Ajusta o CanvasSize do ScrollingFrame quando o texto muda
local function updateTextScroll()
    local textLength = #MiniTextBox.Text
    local charWidth = 8.5  -- Aproximadamente 8.5 pixels por caractere na fonte SourceSans tamanho 15
    local textWidth = textLength * charWidth + 30
    local padding = 20
    local frameWidth = textScrollFrame.AbsoluteSize.X - padding
    
    if textWidth > frameWidth and frameWidth > 0 then
        textScrollFrame.CanvasSize = UDim2.new(0, textWidth + padding, 0, 0)
    else
        textScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
end

MiniTextBox:GetPropertyChangedSignal("Text"):Connect(updateTextScroll)

