function CreateServerSlot(server, index)
    local Slot = Create("Frame", ScrollContainer, {
        Size = UDim2.new(1, 0, 0, 120), 
        BackgroundTransparency = 1, 
        ZIndex = 5,
        LayoutOrder = index
    })

    -- Dados do servidor
    local playing = server.playing or 0
    local maxPlayers = server.maxPlayers or 6
    local ping = server.ping or math.random(20, 150)
    local fps = ping > 0 and math.min(math.floor(1000 / ping), 60) or 0
    local serverId = server.id or "N/A"
    local gameId = game.PlaceId

    -- Cor do ping
    local pingColor
    if ping < 60 then
        pingColor = Color3.fromRGB(0, 255, 100)
    elseif ping < 120 then
        pingColor = Color3.fromRGB(255, 200, 50)
    else
        pingColor = Color3.fromRGB(255, 80, 80)
    end

    -- Texto das informações
    local infoText = string.format(
        "PING : %dms\nFPS : %d\nPLAYERS : %d/%d\n\nGAME ID : %d\nID : %s",
        ping, fps, playing, maxPlayers, gameId, serverId
    )

    -- Label de informações (esquerda)
    local InfoLabel = Create("TextLabel", Slot, {
        Size = UDim2.new(0.65, 0, 1, 0), 
        Position = UDim2.new(0, 15, 0, 0), 
        BackgroundTransparency = 1,
        Font = Enum.Font.Arcade, 
        TextXAlignment = Enum.TextXAlignment.Left, 
        TextYAlignment = Enum.TextYAlignment.Center,
        Text = infoText,
        TextColor3 = Color3.fromRGB(255, 255, 255), 
        TextSize = 16, 
        ZIndex = 6
